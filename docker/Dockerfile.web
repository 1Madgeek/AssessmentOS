# AssessmentOS Web (Next.js standalone)
# Build from repo root:
#   docker build -f docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.assessment.example.com \
#     -t assessmentos-web:local .

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS builder
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY apps/runner/package.json apps/runner/
COPY apps/mcp/package.json apps/mcp/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/sdk/package.json packages/sdk/
COPY packages/ui/package.json packages/ui/
COPY packages/richtext/package.json packages/richtext/
COPY packages/question-mcq/package.json packages/question-mcq/
COPY packages/question-coding/package.json packages/question-coding/
COPY packages/question-sql/package.json packages/question-sql/
COPY packages/question-text/package.json packages/question-text/
COPY packages/question-video/package.json packages/question-video/
COPY packages/question-design/package.json packages/question-design/
COPY packages/question-file/package.json packages/question-file/

RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY apps/api apps/api
COPY apps/runner apps/runner
COPY packages packages
COPY tsconfig.base.json ./

# COPY above replaces package dirs and drops pnpm's per-package node_modules links.
RUN pnpm install --frozen-lockfile

# Public client vars — baked into the JS bundle at build time (not runtime).
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY

RUN pnpm --filter @assessment-os/web... build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

USER nextjs
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
