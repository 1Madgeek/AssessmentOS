# Database
DATABASE_URL=postgresql://assessment:assessment@localhost:5433/assessmentos

# API
API_PORT=4000
API_HOST=0.0.0.0
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Judge0 — leave unset (or set USE_MOCK_RUNNER=true) to use the mock runner (default for local/CI).
# Stock image (I/O only / no unit tools):
#   docker compose up -d judge0 judge0-workers redis
# Unit-ready image (pytest, Jest, PHPUnit, JUnit, GoogleTest):
#   docker compose -f docker-compose.yml -f docker-compose.judge0-unit.yml up -d --build
#   ./scripts/smoke-judge0-unit.sh
# then set:
# JUDGE0_URL=http://localhost:2358
USE_MOCK_RUNNER=true
# Optional: path to junit-platform-console-standalone-*.jar for Java unit mock runs
# JUNIT_CONSOLE_JAR=/path/to/junit-platform-console-standalone-1.10.2.jar

# Invite email (optional — without RESEND_API_KEY, emails log to the API console)
# Put these in the repo-root .env (not apps/api/.env). Restart the API after changing.
# RESEND_API_KEY=re_xxx
# With the default onboarding@resend.dev sender, Resend only delivers to your Resend account email.
# For other recipients, verify a domain in Resend and set EMAIL_FROM to an address on that domain.
# EMAIL_FROM=AssessmentOS <onboarding@resend.dev>

# Invite gate CAPTCHA (optional — unset skips CAPTCHA in local/dev)
# TURNSTILE_SECRET_KEY=0x...
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
# Set when API is behind a reverse proxy so req.ip uses X-Forwarded-For
# TRUST_PROXY=true

# Public recruiter self-signup (default off). Prefer: make create-admin / make k8s-create-admin
# ALLOW_PUBLIC_REGISTER=true

# Local disk storage for rich-text image uploads (Phase 0)
STORAGE_DIR=./data/assets
