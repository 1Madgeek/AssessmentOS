# Database
DATABASE_URL=postgresql://assessment:assessment@localhost:5433/assessmentos

# API
API_PORT=4000
API_HOST=0.0.0.0
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Judge0 — leave unset (or set USE_MOCK_RUNNER=true) to use the mock runner (default for local/CI).
# For real Judge0 unit grading: docker compose up -d judge0 judge0-workers redis
# then set JUDGE0_URL and USE_MOCK_RUNNER=false. Unit mode needs pytest/jest/phpunit
# (and optionally JUnit/gtest) available inside the Judge0 sandbox image.
# JUDGE0_URL=http://localhost:2358
USE_MOCK_RUNNER=true
# Optional: path to junit-platform-console-standalone-*.jar for Java unit mock runs
# JUNIT_CONSOLE_JAR=/path/to/junit-platform-console-standalone-1.10.2.jar

# Invite email (optional — without RESEND_API_KEY, emails log to the API console)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=AssessmentOS <onboarding@resend.dev>

# Invite gate CAPTCHA (optional — unset skips CAPTCHA in local/dev)
# TURNSTILE_SECRET_KEY=0x...
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
# Set when API is behind a reverse proxy so req.ip uses X-Forwarded-For
# TRUST_PROXY=true

# Local disk storage for rich-text image uploads (Phase 0)
STORAGE_DIR=./data/assets
