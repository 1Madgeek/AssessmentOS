    "codex"
  ],
  "dependencies": {},
  "devDependencies": {
    "@assessment-os/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
