{
  "name": "@assessment-os/mcp",
  "version": "0.1.4",
  "private": true,
  "description": "AssessmentOS MCP server for Cursor, Claude, and Codex — published to npm as assessmentos-mcp",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "assessmentos-mcp": "./dist/index.js"
  },
  "files": [
