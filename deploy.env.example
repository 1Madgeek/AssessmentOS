# Copy to deploy.env and fill with your values. Never commit deploy.env.
#
# This file is loaded by Make (`include deploy.env`), not by bash `source`.
# Required for make build / push / k8s-* targets.

# ── Kubernetes ───────────────────────────────────────────────────────────────
K8S_CONTEXT=your-kubectl-context
K8S_NAMESPACE=assessmentos
CLUSTER_ISSUER=letsencrypt-prod
IMAGE_PULL_SECRET=registry-pull-secret

# ── Public hostnames (DNS must point at your ingress LB) ─────────────────────
WEB_HOST=assessment.example.com
API_HOST=api.assessment.example.com

# ── Container registry (DigitalOcean Container Registry or compatible) ───────
DOCTL_CONTEXT=your-doctl-context
DOCR_REGISTRY=registry.example.com
DOCR_REGISTRY_NAME=your-registry-name
# Space- or comma-separated repo names (commas preferred — safe for bash `source`)
DOCR_REPOS=assessmentos-web,assessmentos-api
# Full image names (no tag):
WEB_IMAGE=registry.example.com/your-registry/assessmentos-web
API_IMAGE=registry.example.com/your-registry/assessmentos-api

# ── Optional: baked into the web image at build time ─────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
